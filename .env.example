# Copy to .env and adjust. Paths are relative to the directory the server runs in.

# SQLite database file (created on first run).
DATABASE_URL=data/edms.db

# Where uploaded document files are stored.
STORAGE_DIR=data/files

# Production (node build) only: the largest request body the server accepts.
# The default is 512K, which blocks most uploads. Keep it above the "Max upload
# size" in Settings; the app enforces that limit itself.
BODY_SIZE_LIMIT=100M

# Initial admin account, used only by `npm run db:seed` when it doesn't exist yet.
# Leave ADMIN_PASSWORD empty to have a random one generated and printed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Production (node build) only: the public URL of this server, e.g.
# http://192.168.1.10:3000. Required for form/CSRF checks behind the LAN address.
# ORIGIN=http://localhost:3000
# PORT=3000

# Behind a reverse proxy, the header holding the real client IP. Sign-in
# throttling is per client address, so without it every user shares the proxy's.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Extra origins allowed to call the API cross-origin (comma-separated). The
# desktop app's own origins (tauri://localhost, http(s)://tauri.localhost) are
# always allowed; this is for e.g. trying the desktop build in a browser.
# DESKTOP_ORIGINS=http://localhost:4180
