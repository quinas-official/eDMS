{
	"name": "dms",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"dev:desktop": "node scripts/desktop.js dev",
		"build:desktop": "node scripts/desktop.js build",
		"tauri": "tauri",
		"db:generate": "drizzle-kit generate",
		"db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
		"db:restore": "node --env-file-if-exists=.env scripts/restore.ts",
		"db:studio": "drizzle-kit studio",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@inlang/paraglide-js": "^2.6.0",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.57.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/vite": "^4.1.18",
		"@tauri-apps/cli": "^2.9.6",
		"@types/better-sqlite3": "^9.6.0",
		"@types/file-saver": "^2.0.7",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.0.15",
		"bits-ui": "^2.14.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.1",
		"globals": "^16.5.0",
		"playwright": "^1.57.0",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"vite": "^7.2.6",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.15",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"chart.js": "^4.5.1",
		"clsx": "^2.1.1",
		"diff": "^8.0.2",
		"drizzle-orm": "^0.45.3",
		"file-saver": "^2.0.5",
		"mammoth": "^1.11.0",
		"tailwind-merge": "^3.4.0"
	}
}
